<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dhruv.healthiv</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>export FLIP_GMAIL_APP_PASSWORD=$(security find-generic-password -a darup67@gmail.com -s flip-notifier-gmail -w 2>/dev/null); exec /usr/bin/caffeinate -i /Users/dhruvpatel/biotech-iv-agent/.venv/bin/python /Users/dhruvpatel/biotech-iv-agent/agent.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/dhruvpatel/biotech-iv-agent</string>

    <!-- Weekdays 16:30 local (ET), after the close. Calendar, not StartInterval:
         see the 2026-09-15 launchd StartInterval wedge. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/dhruvpatel/biotech-iv-agent/agent.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/dhruvpatel/biotech-iv-agent/agent.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
