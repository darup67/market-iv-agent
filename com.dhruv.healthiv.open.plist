<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dhruv.healthiv.open</string>

    <!-- Weekdays 09:45 ET: the screen on live, settled quotes. The 16:30 run
         (com.dhruv.healthiv) uses after-close quotes, which widen. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>export FLIP_GMAIL_APP_PASSWORD=$(security find-generic-password -a darup67@gmail.com -s flip-notifier-gmail -w 2>/dev/null); exec /usr/bin/caffeinate -i /Users/dhruvpatel/.venvs/market-ml/bin/python /Users/dhruvpatel/market-iv-agent/agent.py --tag "late-morning screen"</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/dhruvpatel/market-iv-agent</string>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>52</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>52</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>52</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>52</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>52</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/dhruvpatel/market-iv-agent/open.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/dhruvpatel/market-iv-agent/open.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
